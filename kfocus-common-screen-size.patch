diff --git a/package-main/usr/lib/kfocus/lib/common.2.source b/package-main/usr/lib/kfocus/lib/common.2.source
--- a/package-main/usr/lib/kfocus/lib/common.2.source
+++ b/package-main/usr/lib/kfocus/lib/common.2.source
@@ -313,7 +313,8 @@ _cm2CalcEdpScreenSizeFn () {
   fi
 
